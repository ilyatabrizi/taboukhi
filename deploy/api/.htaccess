# /api answers JSON only. apply.php is the one entry point; nothing else here is served.
Options -Indexes
DirectoryIndex apply.php

<FilesMatch "^(?!apply\.php$).+">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
